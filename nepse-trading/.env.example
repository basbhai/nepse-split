# ─────────────────────────────────────────────────────────────────────────────
# nepse-trading — Environment Variables (SAMPLE / DOCUMENTATION ONLY)
# Copy this to .env and fill in ALL values before running.
# NEVER commit the real .env to git — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/nepse_trading

# ── Service-to-service auth ───────────────────────────────────────────────────
# Shared secret used in X-Service-Key header on all engine <-> trading REST calls.
# Must match ENGINE_API_SECRET in nepse-engine/.env exactly.
ENGINE_API_SECRET=<random-long-secret>

# ── Credential encryption ─────────────────────────────────────────────────────
# Fernet symmetric key for encrypting Meroshare and broker passwords.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: losing this key means all stored credentials need re-entry.
CREDENTIAL_ENCRYPTION_KEY=<fernet-key>

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<admin-telegram-chat-id>

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=<discord-bot-token>
DISCORD_ADMIN_ID=<discord-admin-user-id>
DISCORD_CHANNEL_ID=<discord-channel-id>
DISCORD_GUILD_ID=<discord-guild-id>

# ── Dashboard / web UI ────────────────────────────────────────────────────────
# Used as the session secret for web UI cookie auth.
DASHBOARD_AUTH_SECRET=<random-dashboard-auth-secret>

# ── Trading mode ─────────────────────────────────────────────────────────────
SANDBOX_MODE=true

# ── Engine REST base URL ──────────────────────────────────────────────────────
# All engine_client.py calls go here.
ENGINE_BASE_URL=http://127.0.0.1:8766
