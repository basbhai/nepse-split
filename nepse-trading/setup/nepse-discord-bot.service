[Unit]
Description=NEPSE AI — Discord Bot (persistent paper trading interface)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/nepse-trading
ExecStart=/opt/nepse-trading/venv/bin/python -m modules.discord_bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nepse-discord-bot
EnvironmentFile=/opt/nepse-trading/.env

# Auto-restart on failure — wait 10s between attempts
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target